# --- Local environment / secrets ---
# deploy.sh already excludes these from rsync; keep them out of git too.
.env
.env.*
!.env.example

# --- Logs and runtime junk ---
*.log
npm-debug.log*
yarn-error.log*

# --- Editor / OS cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- PHP tooling caches (if added later) ---
.phpunit.result.cache
.php-cs-fixer.cache
